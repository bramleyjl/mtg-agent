{
  "manifest_version": 3,
  "name": "MTG Agent - Moxfield Sync",
  "version": "1.1",
  "description": "Sync a Moxfield deck to pangolin with one click, and auto-capture DeckCheck.co AI analysis on view.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://deckcheck.co/app/deckview/*"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.moxfield.com/*",
    "https://api2.moxfield.com/*",
    "https://deckcheck.co/*",
    "https://web-production-ec9b0.up.railway.app/*",
    "http://YOUR_SERVER_IP:8765/*"
  ],
  "permissions": [
    "activeTab",
    "storage"
  ]
}
